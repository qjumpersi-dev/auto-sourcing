# Copy this file to .env and fill in real values. Never commit .env.

# Database (choose a strong password, min 8 chars, upper/lower/digit/symbol)
SA_PASSWORD=ChangeMe_Str0ng!Pass

# API key that Scotty and the admin app use to authenticate
API_KEY=397951185c451b99dd2c1be564144ee0d51378714d8136ce

# SMTP (outbound email)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=outreach@example.com
SMTP_FROM_NAME=QJumpers AI Sourcing
SMTP_ENABLE_SSL=true

# Signs links in outbound email (unsubscribe tokens). Generate with: openssl rand -base64 32
# If left empty it falls back to API_KEY, but a separate key is better.
EMAIL_SIGNING_KEY=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Rhetorik (candidate sourcing)
RHETORIK_API_KEY=
# Paid "reveal_all_data" contact-email discovery. Leave false unless you intend to pay per profile.
RHETORIK_REVEAL_CONTACT_EMAILS=false

# Scotty (conversation agent)
SCOTTY_API_KEY=
SCOTTY_REST_CHANNEL_ID=
SCOTTY_WEBRTC_CHANNEL_ID=

# OpenAI (content generation + search)
OPENAI_API_KEY=

# Microsoft 365 (Entra ID app registration) - sends outreach email as the signed-in user
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://www.quickmatchai.com/api/auth/microsoft/callback
MICROSOFT_APP_BASE_URL=http://localhost:5173

# LinkedIn: "Server" sends inline (needs a browser on the API host);
# "Local" queues InMails for the local worker (tools/LinkedInWorker).
LINKEDIN_MODE=Local
