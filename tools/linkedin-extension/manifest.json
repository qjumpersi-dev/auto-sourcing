{
  "manifest_version": 3,
  "name": "AITS LinkedIn Sender",
  "version": "1.0.0",
  "description": "Sends queued LinkedIn InMails from your own signed-in LinkedIn session.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.quickmatchai.com/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AITS LinkedIn Sender",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
